# .env.example — copy this to .env and fill in your own values.
# NEVER commit a real .env file to git. Add ".env" to .gitignore.
# This file itself is safe to commit: it holds placeholders, not secrets.

# Server
PORT=3000
HOST=127.0.0.1
NODE_ENV=development
# NODE_ENV is one of: development | test | production

# Logging: debug | info | warn | error
LOG_LEVEL=info

# Database (Phase 03 — fill in when PostgreSQL is set up)
DATABASE_URL=postgres://localhost:5432/devdb

# Auth secret (Phase 04) — required in production, any random string here
JWT_SECRET=change-me-to-a-long-random-string
